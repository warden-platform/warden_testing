# 被测 warden 控制面地址
WARDEN_BASE_URL=http://127.0.0.1:8090

# 本地 warden 源码目录；scripts/stack_up.sh 与凭据回退会用到
# WARDEN_HOME=../warden

# 可选覆盖项。未设置时，config/environment.py 会从
# $WARDEN_HOME/.env 和 $WARDEN_HOME/var/warden/secrets.json 读取。
# WARDEN_ADMIN_USERNAME=admin
# WARDEN_ADMIN_PASSWORD=
# WARDEN_ADMIN_API_KEY=

# 测试数据隔离前缀
# WARDEN_TEST_TENANT_PREFIX=e2e
# WARDEN_TEST_TENANT_ADMIN_NAME=e2e-admin

# HTTP 超时与 TLS 校验
# WARDEN_HTTP_TIMEOUT=30
# WARDEN_VERIFY_TLS=true